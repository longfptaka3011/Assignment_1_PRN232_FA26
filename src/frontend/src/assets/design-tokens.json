  "component": {
    "button": {
      "primary": {
        "background": "linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%)",
        "color": "#0a0a0f",
        "shadow": "0 0 25px rgba(0, 245, 212, 0.3)",
        "shadowHover": "0 8px 30px rgba(0, 245, 212, 0.4)",
        "shadowActive": "0 4px 15px rgba(0, 245, 212, 0.3)"
      },
      "secondary": {
        "background": "#1a1a25",
        "color": "#a1a1aa",
        "border": "1px solid rgba(255, 255, 255, 0.1)",
        "shadowHover": "inset 0 0 15px rgba(0, 245, 212, 0.1)"
      },
      "danger": {
        "background": "linear-gradient(135deg, var(--accent-red) 0%, var(--accent-pink) 100%)",
        "color": "#ffffff",
        "shadowHover": "0 8px 30px rgba(255, 69, 58, 0.4)"
      },
      "ghost": {
        "background": "transparent",
        "color": "#a1a1aa",
        "shadowHover": "background: rgba(255, 255, 255, 0.05)"
      },
      "icon": {
        "size": "40px",
        "radius": "12px"
      },
      "padding": {
        "sm": "8px 14px",
        "md": "12px 24px",
        "lg": "16px 32px"
      },
      "fontSize": {
        "sm": "0.8rem",
        "md": "0.9rem",
        "lg": "1rem"
      },
      "transition": "all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "card": {
      "background": "#15151f",
      "border": "1px solid rgba(255, 255, 255, 0.06)",
      "radius": "20px",
      "shadow": "0 4px 16px rgba(0, 0, 0, 0.5)",
      "shadowHover": "0 8px 24px rgba(0, 0, 0, 0.55), 0 0 30px rgba(0, 245, 212, 0.12)",
      "padding": "24px",
      "transition": "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "input": {
      "background": "#1a1a25",
      "border": "1px solid rgba(255, 255, 255, 0.1)",
      "borderFocus": "1px solid #00f5d4",
      "shadowFocus": "0 0 0 4px rgba(0, 245, 212, 0.12)",
      "radius": "12px",
      "padding": "14px 18px",
      "fontSize": "0.95rem",
      "transition": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "badge": {
      "radius": "9999px",
      "padding": "6px 14px",
      "fontSize": "0.75rem",
      "fontWeight": "600",
      "transition": "all 0.2s ease"
    },
    "modal": {
      "background": "#15151f",
      "border": "1px solid rgba(255, 255, 255, 0.1)",
      "radius": "24px",
      "shadow": "0 20px 50px rgba(0, 0, 0, 0.7), 0 0 50px rgba(0, 245, 212, 0.12)",
      "backdrop": "rgba(0, 0, 0, 0.7)",
      "blur": "8px",
      "animation": "scaleIn 0.3s ease-out"
    },
    "sidebar": {
      "width": "80px",
      "widthExpanded": "280px",
      "background": "linear-gradient(180deg, #0d0d14 0%, #15151f 100%)",
      "border": "1px solid rgba(255, 255, 255, 0.06)",
      "transition": "width 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "table": {
      "background": "#15151f",
      "border": "1px solid rgba(255, 255, 255, 0.06)",
      "radius": "20px",
      "headerBackground": "#1a1a25",
      "headerColor": "#71717a",
      "rowHover": "#1c1c28",
      "cellPadding": "18px 20px"
    },
    "taskCard": {
      "background": "#15151f",
      "border": "1px solid rgba(255, 255, 255, 0.06)",
      "radius": "16px",
      "padding": "24px",
      "gap": "16px",
      "headerBorder": "3px solid",
      "shadowHover": "0 8px 24px rgba(0, 0, 0, 0.55), 0 0 30px rgba(0, 245, 212, 0.12)"
    },
    "chart": {
      "lineColor": "#00f5d4",
      "lineGlow": "url(#glow)",
      "areaGradient": "linear-gradient(180deg, rgba(0, 245, 212, 0.3) 0%, rgba(0, 245, 212, 0) 100%)",
      "gridColor": "#27272a",
      "gridDash": "4,4",
      "pointColor": "#00f5d4",
      "pointRadius": "4px"
    },
    "donutChart": {
      "radius": "70px",
      "strokeWidth": "24px",
      "completedColor": "#30d158",
      "inProgressColor": "#00f5d4",
      "pendingColor": "#ff9500",
      "backgroundColor": "#27272a"
    }
  },

  "animations": {
    "fadeIn": {
      "name": "fadeIn",
      "duration": "250ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["opacity"]
    },
    "fadeInUp": {
      "name": "fadeInUp",
      "duration": "400ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["opacity", "transform"]
    },
    "scaleIn": {
      "name": "scaleIn",
      "duration": "250ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["opacity", "transform"]
    },
    "slideInLeft": {
      "name": "slideInLeft",
      "duration": "400ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "properties": ["opacity", "transform"]
    },
    "bounce": {
      "name": "bounce",
      "duration": "500ms",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "properties": ["transform"]
    },
    "pulse": {
      "name": "pulse",
      "duration": "2s",
      "easing": "ease-in-out",
      "properties": ["opacity"]
    },
    "glow": {
      "name": "glow",
      "duration": "2s",
      "easing": "ease-in-out",
      "properties": ["box-shadow"]
    },
    "float": {
      "name": "float",
      "duration": "3s",
      "easing": "ease-in-out",
      "properties": ["transform"]
    },
    "shimmer": {
      "name": "shimmer",
      "duration": "1.5s",
      "easing": "linear",
      "properties": ["background-position"]
    }
  },

  "microInteractions": {
    "hoverScale": {
      "scale": "1.02",
      "transition": "200ms cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "hoverLift": {
      "translateY": "-4px",
      "transition": "300ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "hoverGlow": {
      "shadow": "0 0 25px rgba(0, 245, 212, 0.3)",
      "transition": "300ms ease"
    },
    "clickScale": {
      "scale": "0.98",
      "transition": "100ms ease"
    },
    "focusRing": {
      "outline": "2px solid #00f5d4",
      "offset": "2px",
      "radius": "6px"
    },
    "ripple": {
      "duration": "500ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },

  "typography": {
    "display": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "2.25rem",
      "fontWeight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "1.875rem",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "1.5rem",
      "fontWeight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "-0.02em"
    },
    "h3": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "1.25rem",
      "fontWeight": "600",
      "lineHeight": "1.2"
    },
    "body": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "small": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "0.875rem",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "caption": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "0.75rem",
      "fontWeight": "500",
      "lineHeight": "1.4",
      "letterSpacing": "0.02em"
    },
    "code": {
      "fontFamily": "'JetBrains Mono', monospace",
      "fontSize": "0.875em"
    }
  }
}
