# Backend Environment Variables (Supabase / PostgreSQL)
# Format 1: Direct Supabase Connection URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Format 2: Connection Pooler (Supabase Session Pooler)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Format 3: Individual Parameters
DATABASE_HOST=db.[PROJECT-REF].supabase.co
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=[YOUR-PASSWORD]

ASPNETCORE_ENVIRONMENT=Development
